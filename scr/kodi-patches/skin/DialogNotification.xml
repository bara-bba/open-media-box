<?xml version="1.0" encoding="UTF-8"?>
<!-- boxy: toast = white pill, black text, right-aligned exactly over the header status
     bar (wide enough to cover it completely) and above every other window -->
<window>
    <zorder>2000</zorder>
    <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="350" tween="sine" easing="out">WindowClose</animation>
    <controls>
        <control type="group">
            <right>80</right>
            <top>46</top>
            <width>580</width>
            <height>68</height>
            <!-- one pill image (two overlapping/adjacent pieces showed a seam while fading) -->
            <control type="image">
                <left>0</left><top>0</top><width>580</width><height>68</height>
                <texture border="34">common/boxy_toast_pill.png</texture>
            </control>
            <control type="image" id="400">
                <left>24</left><top>16</top><width>36</width><height>36</height>
                <aspectratio>keep</aspectratio>
                <colordiffuse>FF000000</colordiffuse>
            </control>
            <control type="label">
                <left>74</left>
                <top>0</top>
                <width>160</width>
                <height>68</height>
                <aligny>center</aligny>
                <font>font_mini</font>
                <textcolor>FF000000</textcolor>
                <label>[B]$INFO[Control.GetLabel(401)][/B]</label>
            </control>
            <!-- message centred in the white space right of the title -->
            <control type="label">
                <left>234</left>
                <top>0</top>
                <width>312</width>
                <height>68</height>
                <align>center</align>
                <aligny>center</aligny>
                <font>font_mini</font>
                <textcolor>FF000000</textcolor>
                <scroll>true</scroll>
                <label>$INFO[Control.GetLabel(402)]</label>
            </control>
        </control>
        <control type="label" id="401">
            <include>Object_Hidden_Item_Definition</include>
        </control>
        <control type="label" id="402">
            <include>Object_Hidden_Item_Definition</include>
        </control>
    </controls>
</window>

<?xml version="1.0" encoding="UTF-8"?>
<window type="window" id="1102">
    <include content="Hub_Onload">
        <param name="window_id">1102</param>
    </include>
    <!-- boxy: new content URL each hour => the recommendations wall re-fetches when you open the tab -->
    <onload>SetProperty(YTReload,$INFO[System.Date(yyyymmdd)]$INFO[System.Time(hh)]$INFO[System.Time(xx)],Home)</onload>
    <controls>
        <include content="Hub_Window">
            <param name="window">1102</param>
        </include>
    </controls>
</window>
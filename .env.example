# Open Media Box — environment config
# Copy to `.env` and fill in your own values. `.env` is gitignored.
# Consumed by scr/provision-pi5.sh and scr/kodi_siri_bridge.py; the docs use
# the same placeholder names.

# --- Pi access ---
SSH_USER=pi
PI_IP=192.168.1.50            # current box IP (Wi-Fi)
PI_IP_ETH=192.168.1.51        # wired IP (when the cable is in)
WIFI_SSID=YourWiFiSSID
LOCAL_DNS=192.168.1.1         # resolver that knows the Jellyfin hostname

# --- Kodi web remote / JSON-RPC ---
KODI_WEB_USER=kodi
KODI_WEB_PASS=change-me

# --- Jellyfin server ---
JELLYFIN_URL=https://jellyfin.example.com     # via reverse proxy
JELLYFIN_DIRECT=http://192.168.1.60:8096      # direct (bypasses the proxy)

# --- Siri Remote (its BLE public address) ---
REMOTE_MAC=AA:BB:CC:DD:EE:FF

# --- Advertised name for Spotify Connect / AirPlay ---
DEVICE_NAME=open-media
